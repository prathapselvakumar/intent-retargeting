(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Slide the bowl along the path)
    (:regions
      (bowl_region
          (:target main_table)
          (:ranges (
              (-0.01 -0.01 0.01 0.01)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    akita_black_bowl_1
  )

  (:init
    (On akita_black_bowl_1 main_table_bowl_region)
  )

  (:goal
    (And (On akita_black_bowl_1 main_table_bowl_region))
  )

)
